{
  "version": 1,
  "pages": [
    {
      "slug": "belegung-und-anfrage",
      "component": "BelegungUndAnfrage",
      "title": "Belegung & Buchungsanfrage",
      "endpoints": [
        {
          "entity": "belegungskalender",
          "op": "list",
          "fields": [
            "anreisedatum",
            "abreisedatum",
            "status"
          ],
          "scope": "r.v_abreisedatum >= today()",
          "scope_description": "zeigt nur Zeiträume, deren Abreise heute oder in der Zukunft liegt (ohne interne Notizen)",
          "max_records": 500
        },
        {
          "entity": "buchungsanfrage",
          "op": "create",
          "fields": [
            "wunsch_anreise",
            "wunsch_abreise",
            "anzahl_personen",
            "vorname",
            "nachname",
            "email",
            "telefon",
            "anmerkungen",
            "datenschutz"
          ]
        }
      ]
    }
  ]
}